# HexWiki uses one fixed OpenAI-compatible route per run.
HEXWIKI_API_KEY=
HEXWIKI_BASE_URL=https://api.openai.com/v1
HEXWIKI_MODEL=

# Optional paths.
HEXWIKI_CONFIG_DIR=
HEXWIKI_RUNS_DIR=

# Optional outbound observability.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENABLED=false

